# 复制为 .env 后填写实际值；.env 已被 Git 忽略。

# 认证模式、身份服务 URL、实例 ID 和超时等非敏感配置写入
# mumble-server.toml；这里只保存敏感令牌。
MUMBLE_EXTERNAL_AUTH_SERVICE_TOKEN=
MUMBLE_IDENTITY_REVALIDATE_TOKEN=
# standalone | core | edge
MUMBLE_MODE=standalone
# edge 模式必填：
# MUMBLE_CORE_ADDRESS=10.0.0.1:64740
# MUMBLE_EDGE_ID=edge-01
# MUMBLE_CORE_CA_CERT=
# MUMBLE_EDGE_CLIENT_CERT=
# MUMBLE_EDGE_CLIENT_KEY=
# MUMBLE_CORE_SERVER_NAME=
# core 模式可选：
# MUMBLE_EDGE_LISTEN=0.0.0.0:64740
# MUMBLE_EDGE_TLS_CERT=
# MUMBLE_EDGE_TLS_KEY=
# MUMBLE_EDGE_CLIENT_CA=
# MUMBLE_EDGE_HEARTBEAT_INTERVAL_SECONDS=5
# MUMBLE_EDGE_HEARTBEAT_TIMEOUT_SECONDS=15
# MUMBLE_EDGE_RECONNECT_MIN_MS=250
# MUMBLE_EDGE_RECONNECT_MAX_MS=5000
# MUMBLE_EDGE_QUEUE_SIZE=256
